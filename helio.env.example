# Helio configuration: the ONE file you edit.
#
#   mkdir -p ~/.config/helio
#   cp helio.env.example ~/.config/helio/helio.env
#   chmod 600 ~/.config/helio/helio.env
#   $EDITOR ~/.config/helio/helio.env        # fill in the secrets below
#   helio update --preview && helio update     # (first install: see docs/setup.md)
#
# `helio update` turns this file into everything Helio actually reads:
#   ~/.dori/elobot/env              Discord bot, channels, paths, models (agent sessions source this)
#   ~/.dori/elobot/beta.env         beta bot secrets (only the beta launcher reads this)
#   ~/.dori/elobot/beta-mongo.env   restricted beta MongoDB URL
#   ~/.dori/elobot/trusted-users, report-channels, release-approvers
#   ~/.dori/elobot/config.json, setup-prompt.md, work-policy.md, runbooks (IDs and paths below are filled in)
# Never edit those generated files by hand; edit this file and run `helio update` again.
#
# Format: KEY=value, one per line. No `export`, no spaces around `=`.
# Lists are comma-separated Discord IDs without spaces. `~` and $HOME are expanded in paths.
# Keep this file private (mode 600). Never commit it.

# --- Discord bot (required) -------------------------------------------------
# Bot token from the Discord Developer Portal -> your application -> Bot -> Reset Token.
DORI_DISCORD_TOKEN=
# Your own Discord user ID (Developer Mode -> right-click yourself -> Copy User ID).
DORI_DISCORD_OWNER_ID=653894110884921366
# Server where the owner-side administration service registers /helio.
HELIO_ADMIN_GUILD=1033924790513311756

# --- Where Helio listens and answers -----------------------------------------
# Outer boundary: Helio only looks at server channels inside this category (and their
# threads). Messages anywhere else in the server are ignored without any lookup. DMs are
# unaffected. Inside it, Helio still only answers in the channels configured below.
DORI_DISCORD_SCOPE_CATEGORY=1210854061050691654
# Every channel Helio reads requests from (trusted + normal + the bug-report channel).
DORI_DISCORD_ALLOWED=1218071208197623880,1199770187738644652,1220331873079922810,1566842840716152962
# Channels Helio never reads, answers or learns from, even inside the scope category.
DORI_DISCORD_IGNORED_CHANNELS=1222942524839165982
# Trusted chat: Helio answers every eligible ping. Channel trust never grants sender authority.
# A thread inside the trusted chat that is also in DORI_DISCORD_ALLOWED (the Bug Reports
# thread) must be listed here too, or inbound refuses to start (ambiguous policy).
DORI_DISCORD_TRUSTED_CHANNELS=1218071208197623880,1566842840716152962
# Normal chats: Helio only considers messages that ping it, and only EloBot-relevant ones.
DORI_DISCORD_NORMAL_CHANNELS=1199770187738644652,1220331873079922810
# Trusted staff chat where Helio announces every issue it creates.
HELIO_STAFF_CHAT=1218071208197623880
# Channels where staff may report bugs / QoL requests that Helio turns into GitHub issues.
HELIO_REPORT_CHANNELS=1218071208197623880,1199770187738644652,1220331873079922810

# --- Answering for you ----------------------------------------------------------
# on: messages that mention you (not Helio) in the channels above reach Helio, which answers
# the EloBot ones it can answer for you and stays silent otherwise. off: only pings to Helio.
HELIO_ANSWER_FOR_OWNER=on
# Helio leaves owner mentions alone while you posted in that channel within this many minutes.
HELIO_OWNER_PRESENT_MINUTES=10

# --- People -----------------------------------------------------------------
# Users who may request PRs and confirm a specific merge or restart (besides you).
HELIO_TRUSTED_USERS=1279092301825704038
# Users whose confirmation the Oracle release broker accepts (besides you).
HELIO_RELEASE_APPROVERS=1279092301825704038

# --- Learning (read-only server knowledge) -------------------------------------
# Category whose text channels Helio reads to learn about EloBot.
DORI_DISCORD_CONTEXT=1210854061050691654
# Channels in that category Helio must not learn from (#elo-matches).
DORI_DISCORD_CONTEXT_EXCLUDED=1222942524839165982
# Category Helio must never learn from.
HELIO_NEVER_LEARN_CATEGORY=888075523044040728

# --- Automatic bug reports from Elo Bot ----------------------------------------
# Elo Bot's user ID and the channel where it posts error reports (evidence only, no authority).
HELIO_BUG_REPORT_BOT=1212767017917218876
HELIO_BUG_REPORT_CHANNEL=1566842840716152962

# --- Beta QA --------------------------------------------------------------------
# Primary channel for live beta command tests, and the category extra test channels must belong to.
HELIO_TEST_CHANNEL=1315329739933618326
HELIO_TEST_CATEGORY=1210854061050691654

# --- EloBot project -------------------------------------------------------------
# The EloBot checkout Helio's lanes work in, and its GitHub repository.
HELIO_PROJECT=~/PythonProjects/elo-bot
HELIO_GITHUB_REPO=jamestesting0/elo-bot

# --- Automatic fixes for minor bugs ----------------------------------------------
# on: for a confirmed bug with a small, test-proven fix, Helio may open a PR on its own
# (`helio autofix submit` enforces the limits below). Merges and restarts still need approval.
HELIO_AUTOFIX=on
# Most non-test lines changed (added + removed) and non-test files an automatic fix may touch.
HELIO_AUTOFIX_MAX_LINES=40
HELIO_AUTOFIX_MAX_FILES=3
# Most automatic-fix PRs open at once.
HELIO_AUTOFIX_MAX_OPEN=3

# Untrusted chats: pings per user per hour that reach Helio (more get one hourglass reaction),
# and how many irrelevant pings within how many hours blacklist a user automatically.
HELIO_PING_LIMIT_PER_HOUR=20
HELIO_AUTOBLOCK_STRIKES=5
HELIO_AUTOBLOCK_WINDOW_H=12
# Courtesy timers run only while an explicit question is waiting on the requester.
HELIO_CONVERSATION_NUDGE_HOURS=24
HELIO_CONVERSATION_TIMEOUT_HOURS=72
# Worker lanes running at once (more launches wait in a queue), and idle minutes before a lane
# is put to sleep with its session kept (it resumes on the next message for that job).
HELIO_MAX_WORKERS=4
# Minutes idle before hibernating a worker; 0 disables hibernation.
HELIO_HIBERNATE_AFTER_MIN=30
# Controller custody for new issue jobs; existing managed jobs continue when this is off.
HELIO_PR_CUSTODY=off
# Paths (comma-separated globs, relative to the EloBot checkout) an automatic fix may never touch.
HELIO_AUTOFIX_DENY=requirements*.txt,pyproject.toml,.github/**,database_models/**,common/tokens/**,**/migrations/**,main.py,beta.py,watchdog.py,scripts/**,models/**,assets/**,*.env*

# --- Models (OpenAI subscription only) -----------------------------------------
# Lead (the always-on Helio session) and workers (lanes). Category models for
# omo's deep-low/deep-high live in omo/omo.jsonc; see omo/README.md.
HELIO_LEAD_MODEL=chatgpt-subscription/gpt-6.1-terra
HELIO_LEAD_THINKING=medium
HELIO_WORKER_MODEL=chatgpt-subscription/gpt-6.1-terra:high
HELIO_MODEL_ALLOW=chatgpt-subscription/*
# BrowserSkill skill directory passed to every session.
HELIO_BROWSER_SKILL=~/.pi/agent/skills/browser-skill

# --- Beta bot secrets (required for beta QA) -------------------------------------
# Written to beta.env / beta-mongo.env only. Never the production token or database.
BOT_BETA_TOKEN=
COC_API_EMAIL=
COC_API_PASSWORD=
HELPER_API_BASE_URL=
HELPER_API_KEY=
# Restricted Atlas user whose privileges are limited to elo_beta. On the isolated
# runtime this must equal MONGO_DB_URL in /etc/helio-beta-service/credential.env.
HELIO_BETA_MONGO_URL=
