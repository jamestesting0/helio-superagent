#!/usr/bin/env bash
# Discord inbound watcher for Helio; run as its persistent monitor.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
source "$here/env"
for name in DORI_DISCORD_TOKEN DORI_DISCORD_ALLOWED DORI_DISCORD_TRUSTED_CHANNELS DORI_DISCORD_NORMAL_CHANNELS DORI_DISCORD_BUG_REPORT_SOURCE; do
  if [ -z "${!name:-}" ]; then
    echo "missing $name in $here/env; set it in ~/.config/helio/helio.env and run: helio update" >&2
    exit 2
  fi
done
export DORI_DISCORD_TRUSTED_IDS="$(<"$here/trusted-users")"
export DORI_DISCORD_REPORT_CHANNELS="$(<"$here/report-channels")"
# A runtime failure (exit 1) is retried: the saved cursor makes the restart catch up
# on anything missed. Configuration failures (exit 2) still stop for a human.
child=
trap '[ -n "$child" ] && kill "$child" 2>/dev/null; exit 143' TERM INT HUP
delay=5
while true; do
  started=$SECONDS
  bun "$HOME/.dori/discord-inbound/inbound.ts" & child=$!
  code=0; wait "$child" || code=$?
  child=
  [ "$code" -eq 1 ] || exit "$code"
  (( SECONDS - started > 600 )) && delay=5
  echo "INBOUND_WARN inbound stopped after a runtime error; restarting in ${delay}s and catching up from the saved cursor"
  sleep "$delay"
  delay=$(( delay * 2 > 300 ? 300 : delay * 2 ))
done
