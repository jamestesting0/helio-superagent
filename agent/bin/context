#!/usr/bin/env bash
# Read-only: prints new messages from Helio's learning channels as CONTEXT lines.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
source "$here/env"
for name in DORI_DISCORD_TOKEN DORI_DISCORD_CONTEXT DORI_DISCORD_CONTEXT_EXCLUDED; do
  if [ -z "${!name:-}" ]; then
    echo "missing $name in $here/env; set it in ~/.config/helio/helio.env and run: helio update" >&2
    exit 2
  fi
done
loop=false
for arg in "$@"; do
  [ "$arg" != --loop ] || loop=true
done
if ! "$loop"; then exec bun "$HOME/.dori/discord-inbound/context.ts" "$@"; fi

child=
timer=
killer=
stamp_path="$HOME/.dori/elobot/monitors-version"
check_seconds="${HELIO_STAMP_CHECK_SECONDS:-30}"
if ! [[ "$check_seconds" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ && "$check_seconds" =~ [1-9] ]]; then
  echo "HELIO_STAMP_CHECK_SECONDS must be positive" >&2
  exit 2
fi
read_stamp() {
  if [ -f "$stamp_path" ]; then cat "$stamp_path"; fi
}
stop_child() {
  [ -n "$child" ] || return 0
  kill -TERM "$child" 2>/dev/null || true
  if kill -0 "$child" 2>/dev/null; then
    sleep 10 & killer=$!
    wait -n -p stopped "$child" "$killer" 2>/dev/null || true
    if [ "${stopped:-}" = "$killer" ]; then kill -KILL "$child" 2>/dev/null || true; fi
  fi
  wait "$child" 2>/dev/null || true
  kill "$killer" 2>/dev/null || true
  wait "$killer" 2>/dev/null || true
  child=
  killer=
}
trap '[ -z "$timer" ] || kill "$timer" 2>/dev/null || true; stop_child; exit 143' TERM INT HUP
delay=5
while true; do
  started=$SECONDS
  stamp="$(read_stamp)"
  bun "$HOME/.dori/discord-inbound/context.ts" "$@" & child=$!
  updated=false
  while true; do
    if ! kill -0 "$child" 2>/dev/null; then
      code=0; wait "$child" || code=$?
      break
    fi
    sleep "$check_seconds" & timer=$!
    code=0; wait -n -p finished "$child" "$timer" 2>/dev/null || code=$?
    if [ "${finished:-}" = "$child" ] || ! kill -0 "$child" 2>/dev/null; then
      code=0; wait "$child" || code=$?
      kill "$timer" 2>/dev/null || true
      wait "$timer" 2>/dev/null || true
      timer=
      break
    fi
    timer=
    new_stamp="$(read_stamp)"
    if [ "$new_stamp" != "$stamp" ]; then
      read -r version _ <<< "$new_stamp" || true
      echo "CONTEXT_WARN updated to $version; restarting to load it"
      stop_child
      updated=true
      break
    fi
  done
  child=
  if "$updated"; then delay=5; continue; fi
  [ "$code" -eq 1 ] || exit "$code"
  (( SECONDS - started > 600 )) && delay=5
  echo "CONTEXT_WARN context stopped after a runtime error; restarting in ${delay}s"
  sleep "$delay"
  delay=$(( delay * 2 > 300 ? 300 : delay * 2 ))
done
