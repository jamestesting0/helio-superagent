#!/bin/bash
# Starts the EloBot Dori lead in the current herdr pane. Run inside: herdr --session elobot
set -euo pipefail

mode="${1:-start}"
if [[ "$mode" != start && "$mode" != resume ]] || (( $# > 1 )); then
  echo "Usage: helio start | helio resume" >&2; exit 2
fi
here="$(cd "$(dirname "$0")" && pwd)"
source "$here/env"
source "$here/browser-env"

for name in DORI_DISCORD_TOKEN DORI_DISCORD_OWNER_ID DORI_DISCORD_ALLOWED HELIO_PROJECT HELIO_LEAD_MODEL HELIO_LEAD_THINKING HELIO_MODEL_ALLOW HELIO_BROWSER_SKILL; do
  if [ -z "${!name:-}" ]; then
    echo "missing $name in $here/env; set it in ~/.config/helio/helio.env and run: helio update" >&2
    exit 2
  fi
done
if [ -z "${HERDR_PANE_ID:-}" ]; then
  echo "run this inside a herdr pane (herdr --session elobot)" >&2
  exit 2
fi

if [ ! -r "$here/setup-prompt.md" ] || [ ! -s "$here/setup-prompt.md" ]; then
  echo "missing, unreadable, or empty $here/setup-prompt.md" >&2
  exit 2
fi
if [ ! -r "$here/work-policy.md" ] || [ ! -s "$here/work-policy.md" ]; then
  echo "missing, unreadable, or empty $here/work-policy.md" >&2
  exit 2
fi
if [ ! -s "$here/skills/karpathy-guidelines/SKILL.md" ]; then
  echo "missing $here/skills/karpathy-guidelines/SKILL.md; run: helio update" >&2
  exit 2
fi
monitor_specs="$(python3 "$here/monitor-specs.py" "$here/docs/monitor-events.md")"
cd "$HELIO_PROJECT"
python3 "$here/knowledge-setup.py" >/dev/null

if [[ "$mode" == resume ]]; then
  session_ref="$(python3 "$here/helio-sessions.py" latest)"
  session_args=(--session "$session_ref")
else
  session_ref="$(python3 "$here/helio-sessions.py" new)"
  session_args=(--session-id "$session_ref")
fi

mkdir -p "$DORI_STATE_DIR"
recovery_status="$(bun "$here/../discord-inbound/recovery.ts" begin)"
# Runtime records live under state/; installed files and config.json are written only by updates.
python3 - "$here/deploy-state.json" "$DORI_STATE_DIR" "$HERDR_PANE_ID" <<'PY'
import datetime, json, os, sys
from pathlib import Path
deploy, state, pane = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
try:
    version = json.loads(deploy.read_text()).get("version") if deploy.is_file() else None
except ValueError:
    version = None
receipt = {"version": version, "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
for name, text in (("lead-start.json", json.dumps(receipt) + "\n"), ("lead-pane", pane + "\n")):
    temporary = state / f".{name}.tmp"
    temporary.write_text(text)
    os.replace(temporary, state / name)
PY

# OmO's positional prompt starts the interactive lead's first turn automatically.
if [[ "$mode" == resume ]]; then
  startup='Resume Helio mode. Persistent monitors restore automatically; arm only those missing from the watching status. Never duplicate a restored monitor.'
else
  startup='Start Helio mode. This new session has no monitors: arm all eight listed below without first listing them.'
fi
startup+=$'\nFollow monitor-events.md, "Arming monitors": one eval cell with a plain for loop (tool.monitor is synchronous in Python; no asyncio). After partial failure, arm only missing monitors. Then batch-read ack pending inbound, ack pending context, helio question list and helio followups list, including continuation pages. Run helio doctor --json and send the owner DM greeting under startup-recovery-workflow.md once receiving status is known. Separate intake readiness, historical work and dated/unprobed dependencies. Read active decisions before work and reconcile recovery before old deliveries. Unfinished recovery does not block new requests.'
startup+=$'\nMonitor specifications (description, command, filter, options), one tool.monitor call each:\n'"$monitor_specs"
startup+=$'\n'"$recovery_status"
exec omo "${session_args[@]}" --no-ask-user --model "$HELIO_LEAD_MODEL" --thinking "$HELIO_LEAD_THINKING" --models "$HELIO_MODEL_ALLOW" --skill "$HELIO_BROWSER_SKILL" --skill "$here/skills/karpathy-guidelines" --append-system-prompt "$here/setup-prompt.md" --append-system-prompt "$here/work-policy.md" "$startup"
