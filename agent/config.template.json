{
  "stateDir": "~/.dori/elobot/state",
  "discordTextHook": "~/.dori/elobot/discord-text.ts",
  "laneWorkspace": "",
  "workspaces": [],
  "ignorePanes": [],
  "leadPane": "",
  "leadPaneFile": "~/.dori/elobot/state/lead-pane",
  "defaultCwd": "{{HELIO_PROJECT}}",
  "agentCommand": [
    "/bin/bash",
    "-c",
    "source \"$HOME/.dori/elobot/env\" || exit; source \"$HOME/.dori/elobot/browser-env\" || exit; exec \"$@\"",
    "helio-worker",
    "/usr/bin/env",
    "DORI_CONFIG={{HOME}}/.dori/elobot/config.json",
    "DORI_STATE_DIR={{HOME}}/.dori/elobot/state",
    "omo",
    "--no-ask-user",
    "--models",
    "{{HELIO_MODEL_ALLOW}}",
    "--skill",
    "{{HELIO_BROWSER_SKILL}}",
    "--skill",
    "{{HOME}}/.dori/elobot/skills/karpathy-guidelines",
    "--append-system-prompt",
    "{{HOME}}/.dori/elobot/work-policy.md",
    "--model",
    "{model}",
    "{prompt}"
  ],
  "defaultModel": "{{HELIO_WORKER_MODEL}}",
  "launchKeywords": "ulw set goal and work",
  "launchProfiles": {
    "thorough": "ulw set goal and work",
    "direct": ""
  },
  "defaultProfile": "thorough",
  "sessionsDir": "~/.omo/agent/sessions",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "heavySlots": 1,
  "maxWorkers": {{HELIO_MAX_WORKERS}},
  "hibernateAfterMin": {{HELIO_HIBERNATE_AFTER_MIN}},
  "runtimeConfigFile": "~/.dori/elobot/policy/lane-settings.json",
  "heavyMaxLoad": 80,
  "deadPanePatterns": [
    "has stopped",
    "no suitable jobs"
  ],
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "hooks": {
    "inspectJobSource": ["helio", "recovery", "source", "{source}", "--job", "{job}"],
    "beforeWake": ["helio", "pr", "phase", "authorize", "--lane", "{key}", "--effect", "wake", "--lane-revision", "{revision}"],
    "beforeComplete": ["helio", "pr", "phase", "authorize", "--lane", "{key}", "--effect", "complete", "--lane-revision", "{revision}"],
    "threadReply": [
      "bun",
      "{{HOME}}/.dori/elobot/thread-target.ts",
      "{thread}",
      "{text}"
    ],
    "threadDone": [
      "bun",
      "{{HOME}}/.dori/elobot/thread-target.ts",
      "{thread}",
      "{text}"
    ]
  }
}
