#!/bin/bash
set -euo pipefail
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"
base="$HOME/.dori/elobot"
case "${1:-}" in
  start) exec "$base/start" start ;;
  resume) exec "$base/start" resume ;;
  dori) shift; source "$base/env"; source "$base/browser-env"; unset HERDR_SOCKET_PATH; export HERDR_SESSION=elobot; exec dori "$@" ;;
  beta) shift; source "$base/env"; source "$base/browser-env"; exec python3 "$HOME/helio-agent/scripts/helio-beta.py" "$@" ;;
  question) shift; source "$base/env"; source "$base/browser-env"
    export DORI_DISCORD_TRUSTED_IDS="$(<"$base/trusted-users")" DORI_DISCORD_REPORT_CHANNELS="$(<"$base/report-channels")"
    exec python3 "$HOME/helio-agent/scripts/helio-questions.py" "$@" ;;
  browser) shift; exec python3 "$HOME/helio-agent/scripts/helio-browser.py" "$@" ;;
  triage) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-triage.py" "$@" ;;
  autofix) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-autofix.py" "$@" ;;
  bugfix) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-bugfix.py" "$@" ;;
  plan) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-plan.py" "$@" ;;
  work) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-plan.py" work "$@" ;;
  decide) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-decide.py" "$@" ;;
  issue) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-issue.py" "$@" ;;
  pr) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-plan.py" pr "$@" ;;
  followups) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio-followups.py" "$@" ;;
  conversation) shift; source "$base/env"; exec bun "$HOME/.dori/discord-inbound/conversation.ts" "$@" ;;
  recovery) shift; source "$base/env"; exec bun "$HOME/.dori/discord-inbound/recovery.ts" "$@" ;;
  blacklist) shift; source "$base/env"; exec bun "$HOME/.dori/discord-inbound/blacklist.ts" "$@" ;;
  housekeeping) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio_housekeeping.py" "$@" ;;
  health) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio_health.py" "$@" ;;
  metrics) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/helio_session_metrics.py" "$@" ;;
  doctor) shift; exec python3 "$HOME/helio-agent/scripts/helio_doctor.py" "$@" ;;
  confirm) shift; source "$base/env"
    export DORI_DISCORD_TRUSTED_IDS="$(<"$base/trusted-users")" HELIO_RELEASE_CHECK="$HOME/helio-agent/scripts/release-check.py"
    exec bun "$HOME/.dori/discord-inbound/interactive/cli.ts" "$@" ;;
  release-check) shift; source "$base/env"; exec python3 "$HOME/helio-agent/scripts/release-check.py" "$@" ;;
  merge) shift; source "$base/env"
    export DORI_DISCORD_TRUSTED_IDS="$(<"$base/trusted-users")"
    exec python3 "$HOME/helio-agent/scripts/helio-merge.py" "$@" ;;
  release) shift; exec python3 "$HOME/helio-agent/scripts/helio_release_client.py" "$@" ;;
  update) shift; exec python3 "$HOME/helio-agent/scripts/sync-install.py" "$@" ;;
  status) exec python3 "$HOME/helio-agent/scripts/helio-status.py" ;;
  permissions) printf '%s\n' "In the normal WSL shell, edit HELIO_TRUSTED_USERS, HELIO_REPORT_CHANNELS or HELIO_RELEASE_APPROVERS in ~/.config/helio/helio.env" "(comma-separated Discord IDs), run: helio update, then exit and relaunch the isolated workspace." ;;
  "") printf '%s\n' 'In Herdr, run: helio start (new) or helio resume (previous)'; exec herdr --session elobot ;;
  *) printf '%s\n' 'Usage: helio [start|resume|dori <args>|beta|question|browser|triage|autofix|bugfix|plan|work|pr|decide|issue|followups|conversation|recovery|blacklist|housekeeping|health|metrics|confirm|merge|doctor|status|update|release-check|release|permissions]' >&2; exit 2 ;;
esac
