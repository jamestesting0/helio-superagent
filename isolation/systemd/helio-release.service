[Unit]
Description=Helio Discord-confirmed Oracle release broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helio-release
Group=helio-release
SupplementaryGroups=helio-agent
RuntimeDirectory=helio-release-service
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=PYTHONNOUSERSITE=1
ExecStart=/opt/helio-beta-service/python/bin/python3.12 -P /opt/helio-beta-service/scripts/helio_release_service.py --config /etc/helio-release-service/auth.json --ssh-config /etc/helio-release-service/ssh_config --db /var/lib/helio-release-service/actions.sqlite --socket /run/helio-release-service/release.sock --uid 999 --gid 999
ExecStopPost=/usr/bin/rm -f /run/helio-release-service/release.sock
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/helio-release-service /run/helio-release-service
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
